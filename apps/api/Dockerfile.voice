# PyAV/aiortc publish manylinux wheels; keep the main Alpine API image unchanged.
FROM python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70 AS builder
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY apps/api/pyproject.toml apps/api/uv.lock ./
RUN pip install --no-cache-dir uv==0.13.5 && uv sync --frozen --no-dev --extra voice --no-install-project
COPY apps/api/app ./app
RUN uv sync --frozen --no-dev --extra voice

FROM python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70 AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH="/app/.venv/bin:${PATH}"
WORKDIR /app
RUN python -m pip uninstall --yes pip \
    && rm -rf /usr/local/lib/python3.12/ensurepip \
    && groupadd --system app && useradd --system --gid app app
COPY --from=builder --chown=app:app /app /app
USER app
EXPOSE 8001
CMD ["uvicorn", "app.voice.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1", "--no-access-log"]
